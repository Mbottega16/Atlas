# SQLite database file (relative to backend/)
DATABASE_URL=sqlite:///./data/atlas.db

# Auth gate (Phase 5). Leave ADMIN_PASSWORD blank for local dev — the gate
# is OFF and every route is open. Set both before deploying anywhere public:
#   ADMIN_PASSWORD  - the single shared password you type to get in
#   ADMIN_SESSION_SECRET - random string used to sign the session cookie
#                          (e.g. `python -c "import secrets;print(secrets.token_urlsafe(32))"`)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Set true when served over HTTPS (Render) so the cookie gets the Secure flag.
COOKIE_SECURE=false
# Origins allowed to call the API cross-origin with credentials (dev only).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Live Claude-assisted capture (Phase 7) — leave blank until explicitly approved.
# Everything that calls this is built and tested with the call mocked out;
# it only activates once a real key is dropped in here.
ANTHROPIC_API_KEY=
